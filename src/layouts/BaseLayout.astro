---
import "@/styles/global.css";
import Sidebar from "@/components/ui/Sidebar.astro";
import ThemeToggle from "@/components/ui/ThemeToggle.astro";
import type { BlockId } from "@/lib/blocks";

interface Props {
  title: string;
  description?: string;
  block?: BlockId;
  currentSlug?: string;
}

const {
  title,
  description = "Curso interactivo para entender la inteligencia artificial y valorar proyectos que la usan, sin necesidad de perfil técnico.",
  block,
  currentSlug,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fullTitle = currentSlug ? `${title} · IA para quien decide` : title;
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem("theme");
        } catch (e) {}
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body class="min-h-screen" data-block={block}>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-card focus:px-3 focus:py-2"
    >
      Saltar al contenido
    </a>

    <header class="no-print sticky top-0 z-30 border-b border-line bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/70">
      <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4">
        <button
          id="menu-btn"
          class="-ml-1 rounded-md p-2 text-muted hover:bg-bg-soft hover:text-fg lg:hidden"
          aria-controls="sidebar"
          aria-expanded="false"
          aria-label="Abrir índice del curso"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <a
          href={`${base}/`}
          class="flex items-center gap-2 font-display text-lg font-semibold tracking-tight"
        >
          <span
            class="grid size-7 place-items-center rounded-lg bg-fg text-sm font-bold text-bg"
            aria-hidden="true"
          >
            IA
          </span>
          <span>IA para quien decide</span>
        </a>
        <div class="ml-auto flex items-center gap-1">
          <a
            href={`${base}/modulos/glosario/`}
            class="hidden rounded-md px-3 py-1.5 text-sm text-muted hover:bg-bg-soft hover:text-fg sm:block"
          >
            Glosario
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <div class="mx-auto flex max-w-7xl">
      <Sidebar currentSlug={currentSlug} />
      <div
        id="sidebar-backdrop"
        class="no-print fixed inset-0 z-30 hidden bg-black/40 lg:hidden"
        aria-hidden="true"
      ></div>
      <main id="contenido" class="min-w-0 flex-1 px-4 pt-8 pb-24 sm:px-8 lg:px-12">
        <slot />
      </main>
    </div>

    <script>
      import "@/scripts/progress";
      import "@/scripts/nav";
    </script>
  </body>
</html>
