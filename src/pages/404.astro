---
import BaseLayout from "@/layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Página no encontrada · IA para quien decide">
  <section class="mx-auto max-w-xl py-20 text-center">
    <p class="font-display text-6xl font-semibold">404</p>
    <h1 class="mt-4 text-2xl font-semibold">Esta página no existe</h1>
    <p class="mt-2 text-muted">
      Puede que el enlace haya cambiado. Vuelve al inicio para ver el mapa del curso.
    </p>
    <a href={`${base}/`} class="mt-6 inline-block rounded-full bg-fg px-6 py-3 font-medium text-bg">
      Ir al inicio
    </a>
  </section>
</BaseLayout>
